# Build only from the isolated context produced by runner-prepare --sandbox-context.
# Publish/optimize in VCR only after the remote manifest and budget are authorized.
FROM node:24.21.0-bookworm-slim@sha256:2fe369e969550cde8e867afc3fe370b260140cab4a23d467074295b42163d553
RUN apt-get update && apt-get install -y --no-install-recommends docker.io && rm -rf /var/lib/apt/lists/*
COPY capsule.tar /opt/alunza/capsule.tar
# The outer image must be pinned by digest; Sandbox does not execute ENTRYPOINT.
