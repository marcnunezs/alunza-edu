# API only. Values are supplied through secure Bicep parameters / ACA secretRef.
DATABASE_URL=
DATABASE_SSL_CA=
# Manual Job only; never API, frontend, image layers or student Sandbox.
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=
RUNNER_SANDBOX_IMAGE=
RUNNER_SANDBOX_REGION=
AI_AUTH_MODE=api-key
AI_AZURE_API_KEY=
AI_MANAGED_IDENTITY_CLIENT_ID=
AI_EMBEDDING_MODEL=
AI_GENERATION_MODEL=
AI_CONFIGURATION_ID=
# Remote smoke client only: public key and three dedicated fictitious accounts.
PREPROD_SUPABASE_PUBLISHABLE_KEY=
PREPROD_SMOKE_ADMIN_EMAIL=admin.a@alunza.test
PREPROD_SMOKE_TEACHER_EMAIL=teacher.a@alunza.test
PREPROD_SMOKE_STUDENT_EMAIL=student.a@alunza.test
PREPROD_SMOKE_PASSWORD=
# Expected owned and foreign fixture organizations; UUIDs, no account data.
PREPROD_OWN_ORGANIZATION_ID=
PREPROD_OTHER_ORGANIZATION_ID=
# Optional dedicated disabled account, independent from the six ACTIVE fixtures.
PREPROD_DISABLED_EMAIL=
PREPROD_DISABLED_PASSWORD=
# Vercel build receives only NEXT_PUBLIC_API_BASE_URL,
# NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY.
# Never copy local runtime.json or local ES256 private signing keys remotely.
