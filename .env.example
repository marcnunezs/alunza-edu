# Inventario de configuracion; este archivo no se carga en todos los servicios.
# local:up + db:migrate generan archivos separados sin imprimir secretos.
# PUBLICAS: apps/web/.env.local
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:4200
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:17421
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_LOCAL
# API: apps/api/.env.local. Nunca trasladar DATABASE_URL al navegador.
PORT=4200
HOST=127.0.0.1
ENVIRONMENT=local
# Remoto: ENVIRONMENT=preproduction, RELEASE_ID=SHA Git de 40 caracteres.
# DATABASE_SSL_CA contiene el PEM del CA Supabase (fuera de este ejemplo).
# DATABASE_URL remota sin query parameters; TLS se configura explícitamente.
APP_ORIGIN=http://localhost:3200
ALLOWED_ORIGINS=http://localhost:3200,http://127.0.0.1:3200
DATABASE_URL=postgresql://alunza_app:REPLACE_LOCAL@127.0.0.1:17422/postgres
SUPABASE_JWKS_URL=http://127.0.0.1:17421/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=http://127.0.0.1:17421/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
# Adaptador administrativo de invitaciones, solo servidor; nunca NEXT_PUBLIC.
INVITATION_WORKER_ENABLED=false
SUPABASE_URL=http://127.0.0.1:17421
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_LOCAL
SUPABASE_SECRET_KEY=REPLACE_SERVER_ONLY
INVITATION_CALLBACK_URL=http://localhost:3200/acceso/invitacion
# BOOTSTRAP: .local/runtime.json, nunca se inyecta entero a ningún consumidor.
# migrationUrl: conexion local privilegiada solo migracion/fixture.
# authAdminKey: fixture y adaptador administrativo de invitaciones local.
# applicationPassword/fixturePassword: generados localmente; nunca versionados.
