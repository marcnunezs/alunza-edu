# Inventario de configuracion; este archivo no se carga en todos los servicios.
# local:up + db:migrate generan archivos separados sin imprimir secretos.
# PUBLICAS: apps/web/.env.local
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:4200
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:17421
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_LOCAL
# API: apps/api/.env.local. Nunca trasladar DATABASE_URL al navegador.
PORT=4200
HOST=127.0.0.1
ENVIRONMENT=local
# RUN local requiere la imagen preparada con npm run runner:prepare.
# La configuración generada para API nativa local/test lo habilita; Compose no
# recibe el socket Docker y conserva RUN deshabilitado.
PRACTICE_RUNNER_ENABLED=false
PRACTICE_ACTOR_CONCURRENCY=1
# SUBMIT comparte el total por organización y frecuencia con RUN.
PRACTICE_SUBMIT_ACTOR_CONCURRENCY=2
PRACTICE_ORGANIZATION_CONCURRENCY=4
PRACTICE_ACTOR_REQUESTS_PER_MINUTE=10
# Remoto: ENVIRONMENT=preproduction, RELEASE_ID=SHA Git de 40 caracteres.
# DATABASE_SSL_CA contiene el PEM del CA Supabase (fuera de este ejemplo).
# DATABASE_URL remota sin query parameters; TLS se configura explícitamente.
APP_ORIGIN=http://localhost:3200
ALLOWED_ORIGINS=http://localhost:3200,http://127.0.0.1:3200
DATABASE_URL=postgresql://alunza_app:REPLACE_LOCAL@127.0.0.1:17422/postgres
SUPABASE_JWKS_URL=http://127.0.0.1:17421/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=http://127.0.0.1:17421/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
# Adaptador administrativo de invitaciones, solo servidor; nunca NEXT_PUBLIC.
INVITATION_WORKER_ENABLED=false
MATERIALS_WORKER_ENABLED=false
HELP_WORKER_ENABLED=false
# Listener de mantenimiento local LAB-EVAL/TEST; nunca API pública ni CORS.
EVALUATION_ENABLED=false
EVALUATION_OPERATIONS_PORT=4401
# Configuración de embeddings opcional para el arranque; sin ella la ingestión
# conserva el archivo y marca un fallo recuperable, nunca READY ficticio.
# Solo API/worker. Configurar el bloque completo para habilitar Azure real.
# AI_AZURE_BASE_URL=https://REPLACE.openai.azure.com/openai/v1/
# AI_AUTH_MODE=azure-cli
# Alternativas: api-key o managed-identity; Azure CLI solo en desarrollo.
# AI_EMBEDDING_DEPLOYMENT=REPLACE
# AI_EMBEDDING_MODEL=REPLACE
# AI_EMBEDDING_DIMENSIONS=REPLACE
# AI_CONFIGURATION_ID=REPLACE
# AI_AZURE_API_KEY=REPLACE_SERVER_ONLY (solo auth mode api-key)
# AI_MANAGED_IDENTITY_CLIENT_ID=REPLACE_UUID (opcional, identidad asignada por usuario)
# Generación/verificación independientes de ingestión, solo API. No activar sin
# deployment/modelo/tokenizer comprobados y artefacto de calibración Azure válido.
# AI_GENERATION_DEPLOYMENT=REPLACE
# AI_GENERATION_MODEL=REPLACE_RESPONSE_MODEL
# AI_GENERATION_CONFIGURATION_ID=REPLACE
# AI_GENERATION_TOKENIZER=o200k_base
# AI_VERIFICATION_DEPLOYMENT=REPLACE (opcional: mismo deployment de generación)
# AI_VERIFICATION_MODEL=REPLACE (opcional: mismo modelo de generación)
# HELP_CALIBRATION_JSON=REPLACE_WITH_VALIDATED_CALIBRATION_ARTIFACT_JSON
# HELP_CALIBRATION_CORPUS_SHA256=REPLACE_WITH_AUTHORIZED_CORPUS_SHA256
SUPABASE_URL=http://127.0.0.1:17421
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_LOCAL
SUPABASE_SECRET_KEY=REPLACE_SERVER_ONLY
INVITATION_CALLBACK_URL=http://localhost:3200/acceso/invitacion
# BOOTSTRAP: .local/runtime.json, nunca se inyecta entero a ningún consumidor.
# migrationUrl: conexion local privilegiada solo migracion/fixture.
# authAdminKey: fixture y adaptadores de servidor Auth/Storage; nunca al navegador.
# applicationPassword/fixturePassword: generados localmente; nunca versionados.
